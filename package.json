{
  "name": "@neo/mahjong-learning",
  "version": "8.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "24.19.0"
  },
  "exports": {
    "./journey": {
      "types": "./lib/journey/index.d.ts",
      "import": "./lib/journey/index.js"
    },
    "./journey-worker": "./lib/journey/runtime.worker.js",
    "./legacy-story-app": {
      "types": "./lib/story-app.d.ts",
      "import": "./lib/story-app.js"
    },
    ".": {
      "types": "./lib/app.d.ts",
      "import": "./lib/app.js"
    },
    "./engine": {
      "types": "./lib/engine/index.d.ts",
      "import": "./lib/engine/index.js"
    },
    "./learning": {
      "types": "./lib/learning/index.d.ts",
      "import": "./lib/learning/index.js"
    },
    "./worker": "./lib/engine/worker.js",
    "./styles.css": "./lib/styles.css",
    "./assets/*": "./assets/*",
    "./build-info": "./lib/build-info.json",
    "./training": {
      "types": "./lib/training/index.d.ts",
      "import": "./lib/training/index.js"
    },
    "./decision": {
      "types": "./lib/decision/index.d.ts",
      "import": "./lib/decision/index.js"
    },
    "./experience": {
      "types": "./lib/experience/index.d.ts",
      "import": "./lib/experience/index.js"
    },
    "./story": {
      "types": "./lib/story/index.d.ts",
      "import": "./lib/story/index.js"
    },
    "./legacy-app": {
      "types": "./lib/decision-app.d.ts",
      "import": "./lib/decision-app.js"
    },
    "./practice": {
      "types": "./lib/practice/index.d.ts",
      "import": "./lib/practice/index.js"
    },
    "./legacy-journey-app": {
      "types": "./lib/journey-app.d.ts",
      "import": "./lib/journey-app.js"
    }
  },
  "files": [
    "lib",
    "assets/tiles/web",
    "assets/tiles/manifest.json",
    "assets/tiles/prompts.json",
    "assets/story/web",
    "assets/story/manifest.json",
    "assets/story/prompts.json",
    "assets/journey/web",
    "assets/journey/manifest.json",
    "assets/journey/prompts.json",
    "README.md",
    "docs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.6.1"
  },
  "dependencies": {
    "chatgpt-desktop-kit": "git+https://github.com/liuminxin45/ChatGPT-Desktop-UI.git#1845915f76e6cc5834f053d5666517650960aa89"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "3.2.4",
    "fake-indexeddb": "6.2.4",
    "playwright": "1.64.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.6.1",
    "sharp": "0.34.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vitest": "3.2.4"
  },
  "scripts": {
    "test:journey-browser": "node scripts/journey-browser.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && node scripts/stage-assets.mjs && vite build",
    "build:package": "node scripts/clean-lib.mjs && tsc -p tsconfig.lib.json && node scripts/package.mjs",
    "prepare": "npm run build:package",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:browser": "node scripts/training-browser.mjs",
    "test:editor": "node scripts/analysis-browser.mjs",
    "check:ui": "node node_modules/chatgpt-desktop-kit/dist/check-consumer.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:coverage": "vitest run --coverage",
    "test:oracle": "node scripts/run-oracle.mjs",
    "bank:build": "tsx scripts/build-bank.ts",
    "bank:verify": "tsx scripts/verify-training.ts && tsx scripts/verify-bank.ts && node scripts/verify-decision-all.mjs",
    "decision:build": "tsx scripts/build-decisions.ts",
    "decision:verify": "tsx scripts/verify-decisions.ts --exact",
    "training:build": "tsx scripts/build-training.ts",
    "test:training-browser": "node scripts/training-browser.mjs",
    "experience:build": "tsx scripts/build-experience.ts",
    "experience:verify": "tsx scripts/verify-story.ts --continuation",
    "story:build": "tsx scripts/build-story.ts",
    "story:verify": "tsx scripts/verify-story.ts",
    "test:story-browser": "node scripts/journey-browser.mjs",
    "journey:verify": "tsx scripts/verify-journey.ts",
    "test:journey-pacing": "node scripts/journey-pacing.mjs",
    "test:practice-browser": "node scripts/practice-browser.mjs && node scripts/practice-resilience.mjs"
  }
}
