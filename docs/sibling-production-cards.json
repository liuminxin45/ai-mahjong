  "closings": {
    "1": {
      "lines": [
        "舅舅说，那一把得算我头上。",
        "她把本子往怀里一收：“可是我坐在这儿。”",
        "我没跟她争。她得意了一小会儿，才往旁边挪，让我坐得松快一点。"
      ],
      "next": "坐得近一点"
    },
    "2": {
      "lines": [
        "我说了车次。她用笔在纸上点了一下，没有写。",
        "“那还有时间。”",
        "这句话我记得。后面她又说过什么，我已经记不全。",
        "纸上的牌倒还在，有些是当场记的，有些是她后来补的。"
      ],
      "next": "看她后来补的几页"
    },
    "3": {
      "lines": [
        "楼道里传来脚步声。母亲回来了。",
        "她把明早去墓园的袋子放在门边，转身看见桌上摊开的本子。",
        "“这个，也带上？”",
        "我把压在纸角的手挪开，没有合上。",
        "母亲站了一会儿，说饭还要等一等，让我慢慢收。"
      ],
      "next": "再坐一会儿"
    },
    "4": {
      "lines": [
        "后面几页，有一行字被她框了起来。",
        "“给哥留着。”",
        "我往后摸了摸，纸还挺厚。原来她说自己会一点的时候，已经写了这么多。",
        "我把椅子往桌边拉近，照她记下的顺序，重新摆牌。"
      ],
      "next": "把她留的题摆好"
    }
  },
  "ending": [
    {
      "lines": [
        "横线后面，是她给这一手写的解释。",
        "有几处字被改过，最后一句倒写得很干脆。",
        "“先看看桌上有什么。”",
        "“这句是你以前说我的。现在还给你。”"
      ],
      "next": "看完她写的最后几行"
    },
    {
      "lines": [
        "我又翻了两页。",
        "前面常写着“哥说的”。后来有一处被她划掉，改成了“我试过了”。",
        "我想起她当时递来本子，问我要不要看看。",
        "原来她已经准备好，要跟我讲这些了。"
      ],
      "next": "把那页夹回原处"
    },
    {
      "lines": [
        "“收好了吗？”母亲在门外问。",
        "我把本子从纸箱里拿出来，放进自己的包。",
        "“这本我带走。”",
        "她看了一眼，没再问。"
      ],
      "next": "收好那本牌谱"
    },
    {
      "lines": [
        "窗外已经全黑了。楼下有人喊吃饭。",
        "我把笔夹回本子里，拉上包。",
        "起身时，顺手把旁边那把椅子推回桌下。",
        "椅脚擦过地面，和我记得的声音一样。"
      ],
      "next": "合上牌谱"
    }
